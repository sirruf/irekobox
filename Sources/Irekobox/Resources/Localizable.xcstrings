          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上的 `%@` → `%@`"
          }
        }
      }
    },
    "This decides its address. Kubernetes calls the address in front of an app a Service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das bestimmt seine Adresse. Kubernetes nennt die Adresse vor einer App einen Service."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによってアドレスが決まります。Kubernetes では、App の前に置かれるアドレスを Service と呼びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От этого зависит его адрес. Адрес перед приложением в Kubernetes называется Service."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这决定了它的地址。Kubernetes 将应用前面的地址称为 Service。"
          }
        }
      }
    },
    "This folder comes from **%@** on your Mac — changes show up on both sides." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner stammt aus **%@** auf Ihrem Mac — Änderungen erscheinen auf beiden Seiten."
