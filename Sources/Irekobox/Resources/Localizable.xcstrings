    },
    "The containers this project runs, one entry per service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Container, die dieses Projekt ausführt, ein Eintrag pro Dienst."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトが実行するコンテナ。サービスごとに 1 項目です。"
