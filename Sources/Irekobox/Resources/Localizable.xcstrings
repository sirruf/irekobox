          }
        }
      }
    },
    "Settings kept in the cluster (files or values) that pods read, so the image needn't change when settings do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Cluster gespeicherte Einstellungen (Dateien oder Werte), die Pods lesen, damit sich das Image nicht ändern muss, wenn sich Einstellungen ändern."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラスタに保持され、Pod が読み込む設定（ファイルまたは値）です。設定を変えてもイメージを変更する必要がありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
