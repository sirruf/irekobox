          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespace 是集群中存放应用的文件夹"
          }
        }
      }
    },
    "A namespace: a folder that keeps this project's objects together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Namespace: ein Ordner, der die Objekte dieses Projekts zusammenhält."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespace: このプロジェクトのオブジェクトをまとめておくフォルダ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespace: папка, в которой хранятся объекты этого проекта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespace：将此项目的对象集中存放的文件夹。"
          }
        }
      }
    },
    "A native Mac app for Apple’s `container`: run apps, Compose projects, machines and Kubernetes without Docker Desktop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine native Mac-App für Apples `container`: Apps, Compose-Projekte, Maschinen und Kubernetes ausführen — ohne Docker Desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の `container` 用のネイティブ Mac App。Docker Desktop なしで App、Compose プロジェクト、マシン、Kubernetes を実行できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нативное приложение для Mac для `container` от Apple: запускайте приложения, проекты Compose, машины и Kubernetes без Docker Desktop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 Apple `container` 的原生 Mac 应用：无需 Docker Desktop 即可运行应用、Compose 项目、虚拟机和 Kubernetes。"
          }
        }
      }
    },
    "A native UI for Apple containers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine native Oberfläche für Apple-Container"
          }
        },
        "ja" : {
          "stringUnit" : {
