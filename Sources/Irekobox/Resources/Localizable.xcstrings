        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージのビルド対象のプロセッサ。arm64 は Apple シリコンでネイティブに動作し、amd64 イメージは Rosetta 経由で少し遅く動作します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
