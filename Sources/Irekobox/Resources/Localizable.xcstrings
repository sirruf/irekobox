    },
    "Irekobox runs Linux containers with Apple's open-source container tool: each container gets its own lightweight virtual machine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irekobox führt Linux-Container mit Apples Open-Source-Tool container aus: Jeder Container erhält seine eigene schlanke virtuelle Maschine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irekobox は Apple のオープンソースの container ツールで Linux コンテナを実行します。各コンテナには専用の軽量な仮想マシンが割り当てられます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irekobox запускает контейнеры Linux с помощью открытого инструмента container от Apple: каждый контейнер получает собственную лёгкую виртуальную машину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irekobox 使用 Apple 的开源 container 工具运行 Linux 容器：每个容器都有自己的轻量级虚拟机。"
          }
        }
      }
    },
