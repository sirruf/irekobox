          }
        }
      }
    },
    "Its disk and everything installed in it is removed. Your home folder on the Mac is not touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Festplatte und alles darauf Installierte werden entfernt. Ihr Privatordner auf dem Mac bleibt unberührt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクとそこにインストールしたものはすべて削除されます。Mac 上のホームフォルダには影響しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск машины и всё установленное на нём будут удалены. Ваша домашняя папка на Mac не затрагивается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其磁盘及其中安装的所有内容都将被移除。Mac 上的个人文件夹不受影响。"
          }
        }
      }
    },
    "Its health check fails" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integritätsprüfung schlägt fehl"
