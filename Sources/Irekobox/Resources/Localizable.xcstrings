          "stringUnit" : {
            "state" : "translated",
            "value" : "Кластер в виде карты или карточек"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以拓扑图或卡片显示集群"
          }
        }
      }
    },
    "The cluster pulls %@ itself" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cluster lädt %@ selbst"
