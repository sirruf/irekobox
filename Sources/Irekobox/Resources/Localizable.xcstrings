        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以后可以重新拉取。"
          }
        }
      }
    },
    "It doesn't listen on any port. If nothing should connect to it, run it as a worker." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lauscht auf keinem Port. Wenn sich nichts damit verbinden soll, führen Sie es als Worker aus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのポートでも待ち受けていません。接続する必要がなければ、ワーカーとして実行してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он не слушает ни один порт. Если к нему ничего не должно подключаться, запустите его как фоновый обработчик."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它没有监听任何端口。如果不需要任何东西连接它，请将它作为工作进程运行。"
          }
        }
      }
    },
