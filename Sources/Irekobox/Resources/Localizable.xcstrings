        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其数据将被永久删除。"
          }
        }
      }
    },
    "Its data, used by %@, will be gone for good. It stops working until it is recreated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Daten, genutzt von %@, gehen endgültig verloren. Der Container funktioniert erst wieder, wenn er neu erstellt wird."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が使用しているデータが完全に失われます。再作成されるまで動作しなくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его данные будут удалены безвозвратно; их использует %@. Он перестанет работать, пока его не создадут заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用的其数据将被永久删除。在重新创建之前，它将无法工作。"
          }
        }
      }
    },
    "Its data, used by %@, will be gone for good. They stop working until they are recreated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Daten, genutzt von %@, gehen endgültig verloren. Die Container funktionieren erst wieder, wenn sie neu erstellt werden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が使用しているデータが完全に失われます。再作成されるまで動作しなくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его данные будут удалены безвозвратно; их используют %@. Они перестанут работать, пока их не создадут заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
