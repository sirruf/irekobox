          }
        }
      }
    },
    "Nothing has happened since Irekobox opened. Starts, stops and health changes show up here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Öffnen von Irekobox ist nichts passiert. Starts, Stopps und Integritätsänderungen erscheinen hier."
          }
