    "%@ is still held by a deleted machine until the engine restarts, so this one is called %@. Create it again, or type another name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist bis zum Neustart der Engine noch von einer gelöschten Maschine belegt, daher heißt diese %2$@. Erneut erstellen oder einen anderen Namen eingeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is still held by a deleted machine until the engine restarts, so this one is called %2$@. Create it again, or type another name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はエンジンを再起動するまで削除済みのマシンが使用中のため、このマシンは %2$@ になります。もう一度作成するか、別の名前を入力してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя %1$@ занято удалённой машиной до перезапуска движка, поэтому новая машина будет называться %2$@. Создайте её ещё раз или введите другое имя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在引擎重启前，%1$@ 仍被一台已删除的虚拟机占用，因此这台将命名为 %2$@。请再次创建，或输入其他名称。"
          }
        }
