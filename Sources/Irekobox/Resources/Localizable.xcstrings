    "It can be pulled again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kann später erneut geladen werden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで再びプルできます。"
