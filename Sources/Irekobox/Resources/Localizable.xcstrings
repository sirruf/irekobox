    "It ran out of memory: raise its memory limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsspeicher reichte nicht aus: Erhöhen Sie das Speicherlimit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ不足になりました。メモリの上限を引き上げてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не хватило памяти: увеличьте лимит памяти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的内存不足：请提高其内存限制。"
          }
        }
      }
    },
    "It starts and exits again and again; its logs say why. Kubernetes waits longer between tries each time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es startet und beendet sich immer wieder; die Logs nennen den Grund. Kubernetes wartet zwischen den Versuchen jedes Mal länger."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動と終了を繰り返しています。理由はログで確認できます。Kubernetes は試行のたびに待ち時間を長くします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он раз за разом запускается и завершается; причина — в его логах. Kubernetes каждый раз ждёт дольше перед новой попыткой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它反复启动又退出；其日志会说明原因。Kubernetes 每次重试之间的等待时间会越来越长。"
          }
        }
      }
    },
    "It was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde gelöscht."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除されました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он был удалён."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已被删除。"
          }
        }
      }
    },
    "It was running at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lief um %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
