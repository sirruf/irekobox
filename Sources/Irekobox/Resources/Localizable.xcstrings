            "value" : "发布端口，然后点按它：localhost:8080 会显示内部运行的内容。"
          }
        }
      }
    },
    "Publish ports on this Mac, as \"host:container\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
