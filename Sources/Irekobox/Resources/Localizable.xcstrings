        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac"
          }
        }
      }
    },
    "This Mac can't reach the container's network: Local Network access may be off for Irekobox." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac erreicht das Netzwerk des Containers nicht: Der Zugriff auf das lokale Netzwerk ist für Irekobox möglicherweise deaktiviert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac からコンテナのネットワークに接続できません: Irekobox のローカルネットワークへのアクセスがオフになっている可能性があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac не может подключиться к сети контейнера: возможно, для Irekobox отключён доступ к локальной сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 无法访问容器的网络：Irekobox 的本地网络访问权限可能已关闭。"
          }
        }
      }
    },
    "This Mac on `%@` → `%@`" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac auf `%@` → `%@`"
          }
