    "Publish a port, then click it: localhost:8080 shows what runs inside." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie einen Port frei und klicken Sie darauf: localhost:8080 zeigt, was darin läuft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
