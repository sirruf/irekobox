          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止时强制终止前等待的时间。"
          }
        }
      }
    },
    "How many CPUs and how much memory the container's VM gets. Defaults suit most apps; databases and builds like more memory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele CPUs und wie viel Arbeitsspeicher die VM des Containers erhält. Die Standardwerte passen für die meisten Apps; Datenbanken und Builds mögen mehr Arbeitsspeicher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナの VM に割り当てる CPU とメモリの量。ほとんどの App はデフォルトで十分ですが、データベースやビルドではメモリを多めにすると快適です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько ЦП и памяти получает виртуальная машина контейнера. Значения по умолчанию подходят большинству приложений; базам данных и сборкам нужно больше памяти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器的虚拟机可获得的 CPU 数量和内存大小。默认值适合大多数应用；数据库和构建需要更多内存。"
          }
        }
      }
    },
    "How many copies" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Kopien"
          }
