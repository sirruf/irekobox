    "%@ has been failing its health check since %@ — it may be the cause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ besteht seit %2$@ die Integritätsprüfung nicht — das könnte die Ursache sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has been failing its health check since %2$@ — it may be the cause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は %2$@ からヘルスチェックに失敗しています。これが原因の可能性があります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не проходит проверку состояния с %@ — возможно, причина в нём."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 自 %2$@ 起未通过健康检查，可能是问题所在。"
          }
        }
      }
    },
    "%@ has been stopped since %@ — errors reaching it are expected until it's back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist seit %2$@ gestoppt — bis zum erneuten Start sind Verbindungsfehler zu erwarten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has been stopped since %2$@ — errors reaching it are expected until it's back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は %2$@ から停止しています。再開するまで接続エラーが発生するのは想定どおりです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ остановлен с %@ — ошибки при обращении к нему ожидаемы, пока он снова не заработает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 自 %2$@ 起已停止，在它恢复前无法访问属于正常现象。"
          }
        }
      }
    },
    "%@ has no containers yet; start it once in Irekobox." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine Container; starten Sie es einmal in Irekobox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にはまだコンテナがありません。Irekobox で一度起動してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ пока нет контейнеров; запустите его один раз в Irekobox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还没有容器；请在 Irekobox 中启动一次。"
          }
        }
      }
    },
    "%@ has no init system (/sbin/init), so a machine stops right after it starts. Use Ubuntu, Debian, Fedora (Irekobox adds systemd) or Alpine, or an image with an init." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat kein Init-System (/sbin/init), daher stoppt eine Maschine direkt nach dem Start. Verwenden Sie Ubuntu, Debian, Fedora (Irekobox fügt systemd hinzu) oder Alpine oder ein Image mit Init-System."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ には init システム（/sbin/init）がないため、マシンは起動直後に停止します。Ubuntu、Debian、Fedora（Irekobox が systemd を追加します）、Alpine、または init を含むイメージを使用してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ нет системы инициализации (/sbin/init), поэтому машина останавливается сразу после запуска. Используйте Ubuntu, Debian, Fedora (Irekobox добавит systemd) или Alpine либо образ с init."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有 init 系统（/sbin/init），因此虚拟机会在启动后立即停止。请使用 Ubuntu、Debian、Fedora（Irekobox 会添加 systemd）或 Alpine，或者带有 init 的镜像。"
          }
        }
      }
    },
