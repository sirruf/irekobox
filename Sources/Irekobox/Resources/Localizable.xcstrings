    "Unused: %@ and %lld more. They can be pulled again later. Untagged layers are leftovers from images that were rebuilt or pulled again." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unbenutzt: %@ und %lld weiteres. Sie können später erneut geladen werden. Layer ohne Tag sind Reste von Images, die neu erstellt oder erneut geladen wurden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Unbenutzt: %@ und %lld weitere. Sie können später erneut geladen werden. Layer ohne Tag sind Reste von Images, die neu erstellt oder erneut geladen wurden."
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unused: %1$@ and %2$lld more. They can be pulled again later. Untagged layers are leftovers from images that were rebuilt or pulled again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未使用: %@ ほか %lld 個。あとで再びプルできます。タグなしのレイヤーは、再ビルドまたは再プルされたイメージの残りです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не используются: %@ и ещё %lld. Их можно будет скачать снова. Слои без тегов — это остатки образов, которые были пересобраны или скачаны заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未使用：%@ 及另外 %lld 个。以后可以重新拉取。未标记的层是重新构建或重新拉取的镜像留下的残余。"
          }
        }
      }
    },
