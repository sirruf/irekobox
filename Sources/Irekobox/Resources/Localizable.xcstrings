            "value" : "Bind mount %1$@ → %2$@ (no copy needed)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バインドマウント %1$@ → %2$@（コピー不要）"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение папки %@ → %@ (копирование не нужно)"
          }
        },
        "zh-Hans" : {
