          }
        }
      }
    },
    "Publishing a port makes the app reachable from this Mac: localhost:8080 → port 80 inside. Without it only other containers reach the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein freigegebener Port macht die App von diesem Mac aus erreichbar: localhost:8080 → Port 80 darin. Ohne ihn erreichen nur andere Container die App."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポートを公開すると、この Mac から App に接続できるようになります: localhost:8080 → 内部のポート 80。公開しない場合、App に接続できるのはほかのコンテナだけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытый порт делает приложение доступным с этого Mac: localhost:8080 → порт 80 внутри. Без него к приложению могут подключаться только другие контейнеры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布端口后，即可从这台 Mac 访问应用：localhost:8080 → 内部端口 80。否则只有其他容器能访问该应用。"
          }
        }
      }
    },
