        }
      }
    },
    "If a workload owns it, a fresh pod replaces it; a pod on its own is gone for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehört er zu einem Workload, ersetzt ihn ein neuer Pod; ein eigenständiger Pod ist endgültig weg."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークロードが管理している場合は新しい Pod に置き換えられます。単独の Pod は完全に失われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если под принадлежит рабочей нагрузке, его заменит новый; отдельный под удаляется безвозвратно."
          }
        },
        "zh-Hans" : {
