          "stringUnit" : {
            "state" : "translated",
            "value" : "它们的数据将被永久删除。"
          }
        }
      }
    },
    "Their data, used by %@, will be gone for good. They stop working until they are recreated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Daten, genutzt von %@, sind endgültig weg. Diese funktionieren erst wieder, wenn sie neu erstellt werden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が使用しているデータは完全に失われます。再作成するまで動作しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их данные, которые использует %@, будут удалены навсегда. Они перестанут работать, пока их не пересоздадут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们的数据（%@ 正在使用）将被永久删除。在重新创建之前，它们将无法工作。"
          }
        }
      }
    },
    "There's no folder here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
