    "Your %lld containers and %lld machines are safe and will come back as they were. Nothing runs until you start it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Container (%lld) und Maschinen (%lld) sind sicher und kommen unverändert zurück. Nichts läuft, bis Sie es starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your %1$lld containers and %2$lld machines are safe and will come back as they were. Nothing runs until you start it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個のコンテナと %lld 台のマシンは安全で、元の状態に戻ります。起動するまで何も実行されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши контейнеры (%lld) и машины (%lld) в безопасности и вернутся в прежнем виде. Ничего не запустится, пока вы это не запустите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 %lld 个容器和 %lld 台虚拟机都安然无恙，并会恢复原状。在你启动之前，不会运行任何内容。"
          }
        }
      }
    },
