          }
        }
      }
    },
    "Running ones are stopped first. Files written inside them are lost; volumes are kept. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende werden zuerst gestoppt. Darin geschriebene Dateien gehen verloren; Volumes bleiben erhalten. Dies kann nicht widerrufen werden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のものは先に停止されます。内部で書き込まれたファイルは失われ、ボリュームは保持されます。この操作は取り消せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работающие контейнеры сначала будут остановлены. Файлы, записанные внутри них, будут потеряны; тома сохранятся. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的会先停止。在其内部写入的文件将丢失；卷会保留。此操作无法撤销。"
          }
        }
      }
    },
