    "The Docker socket mount (%@) is left out: a container can't receive a socket" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mount des Docker-Sockets (%@) wird weggelassen: Ein Container kann keinen Socket empfangen"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker ソケットのマウント（%@）は除外されます: コンテナはソケットを受け取れません"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение сокета Docker (%@) не переносится: контейнер не может получить сокет"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker 套接字挂载（%@）将被省略：容器无法接收套接字"
          }
        }
      }
    },
    "The VM holds %@ of this Mac's memory while the container uses %@. Linux VMs don't give freed memory back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM belegt %@ des Arbeitsspeichers dieses Macs, während der Container %@ nutzt. Linux-VMs geben freigewordenen Speicher nicht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The VM holds %1$@ of this Mac's memory while the container uses %2$@. Linux VMs don't give freed memory back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナが %2$@ を使用している一方で、VM はこの Mac のメモリを %1$@ 確保しています。Linux VM は解放したメモリを返却しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ВМ удерживает %@ памяти этого Mac, а контейнер использует %@. ВМ Linux не возвращают освобождённую память."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机占用了这台 Mac 的 %1$@ 内存，而容器只使用 %2$@。Linux 虚拟机不会归还已释放的内存。"
          }
        }
      }
    },
    "The VM holds %@; the container uses %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM belegt %@; der Container nutzt %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The VM holds %1$@; the container uses %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM は %1$@ を確保し、コンテナは %2$@ を使用しています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ВМ удерживает %@; контейнер использует %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机占用 %1$@；容器使用 %2$@。"
          }
        }
      }
    },
    "The VM stops and its disk is deleted. Files in your home folder stay." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM остановится, её диск будет удалён. Файлы в вашей домашней папке останутся."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM stoppt und ihre Festplatte wird gelöscht. Dateien in Ihrem Benutzerordner bleiben."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM は停止し、そのディスクは削除されます。ホームフォルダのファイルは残ります。"
