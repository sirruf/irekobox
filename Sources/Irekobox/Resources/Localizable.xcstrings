    "How many copies (pods) run at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Kopien (Pods) gleichzeitig laufen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時に実行するコピー（Pod）の数。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько копий (подов) работает одновременно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时运行的副本（Pod）数量。"
          }
        }
      }
    },
    "How many copies Kubernetes keeps running; click another app on the map to scale it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Kopien Kubernetes am Laufen hält; klicken Sie auf der Karte auf eine andere App, um sie zu skalieren"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubernetes が実行し続けるコピーの数。マップでほかの App をクリックするとスケールできます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько копий Kubernetes поддерживает запущенными; нажмите на другое приложение на карте, чтобы масштабировать его"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kubernetes 保持运行的副本数；点按拓扑图上的其他应用以对其扩缩"
          }
        }
      }
    },
    "How many copies of %@?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Kopien von %@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のコピー数は？"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько копий %@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要多少个副本？"
          }
        }
      }
    },
    "How many pods of the app run at once. Two or more share the work and keep the app up while one restarts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Pods der App gleichzeitig laufen. Zwei oder mehr teilen sich die Arbeit und halten die App verfügbar, während einer neu startet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App の Pod を同時にいくつ実行するか。2 つ以上あれば処理を分担し、1 つが再起動しても App は稼働し続けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько подов приложения работает одновременно. Два и больше делят нагрузку, и приложение остаётся доступным, пока один из них перезапускается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用同时运行的 Pod 数量。两个或以上可以分担工作，并在其中一个重新启动时保持应用可用。"
          }
        }
      }
    },
    "How often the container list refreshes while visible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft die Containerliste aktualisiert wird, solange sie sichtbar ist."
