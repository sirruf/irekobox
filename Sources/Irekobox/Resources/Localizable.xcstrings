        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナは削除されます。ボリュームと Compose ファイルは残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его контейнеры будут удалены. Тома и файл Compose останутся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其容器将被删除。卷和 Compose 文件会保留。"
          }
