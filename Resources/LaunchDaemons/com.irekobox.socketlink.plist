<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.irekobox.socketlink</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/IrekoboxSocketLink</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>WatchPaths</key>
	<array>
		<string>/Users/Shared/Irekobox/docker-sock</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.irekobox.app</string>
	</array>
</dict>
</plist>
